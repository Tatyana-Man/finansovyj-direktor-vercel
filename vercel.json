{
 "buildCommand": "",
 "installCommand": "",
 "outputDirectory": "deploy",
 "cleanUrls": true,
 "trailingSlash": true,
 "headers": [
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800"
    }
   ]
  },
  {
   "source": "/img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800"
    }
   ]
  }
 ]
}